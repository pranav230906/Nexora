# Django General Config
DEBUG=True
SECRET_KEY=django-insecure-development-secret-key-life-saver
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL database URI
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifesaver

# Redis URL for celery, caching, and websockets channels
REDIS_URL=redis://127.0.0.1:6379/0

# JWT Auth parameters
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# OpenAI API Key (For smart scheduler and assistant coaching prompts)
OPENAI_API_KEY=your-openai-api-key-here

# Firebase Cloud Messaging Credentials (for app task alerts & notifications)
FIREBASE_CREDENTIALS_JSON_PATH=/path/to/firebase-credentials.json

# Google Integration keys (For fetching user schedules and auth credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
